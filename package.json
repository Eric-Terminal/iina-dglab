    "test": "node node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "test:native": "node scripts/test-native.mjs",
    "test:mpv": "node node_modules/tsx/dist/cli.mjs scripts/test-mpv.ts",
    "test:timing": "node node_modules/tsx/dist/cli.mjs scripts/test-timing.ts",
    "pack": "npm run build && npm run build:native && node scripts/pack.mjs"
  },
